FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    OPERUM_DATA_DIR=/app/data

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends build-essential curl libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.prod.txt ./
RUN python -m pip install --upgrade pip \
    && python -m pip install -r requirements.prod.txt

COPY app ./app
COPY data/assets ./data/assets
COPY docs/knowledge ./docs/knowledge

RUN mkdir -p /app/data/logs /app/data/news /app/data/cache /app/data/models /app/data/market /app/data/portfolios /app/data/ai \
    && useradd --create-home --shell /usr/sbin/nologin operum \
    && chown -R operum:operum /app

USER operum

EXPOSE 8001

HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD python -c "import urllib.request; urllib.request.urlopen('http://127.0.0.1:8001/api/health', timeout=5).read()"

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8001"]
